# Copy to .env (or .env.local) and fill in. Never commit real values.
#
# Names match bb-app's .env, so an existing bb-app .env works unchanged. next.config.ts exposes
# ONLY the "public" group to the browser (as NEXT_PUBLIC_*); everything else stays server-side.
# You may also set the NEXT_PUBLIC_* names directly — they take precedence.

# ---- Public (sent to the browser) ----
# LOCAL | FIREFLY (dev) | DRAGONFLY (staging) | BUTTERFLY (production)
NEXT_ENV="LOCAL"
NEXT_ENDPOINT="http://localhost:3000"
NEXT_API_ENDPOINT=""
SOCKET_SERVER_URL=""
ENABLE_CAPTCHA="0"
CAPTCHA_SITE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_REDIRECT_URI=""
GOOGLE_CLIENT_ID=""
GOOGLE_REDIRECT_URI=""
S3_IMAGE_PATH=""
BB_APPLICATION_HEADER="ui"
BB_VERSION="1"

# ---- Server-only (read by proxy.ts / server code, never exposed) ----
ENABLE_BASIC_AUTH="0"
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
